# Copy this file to .env and fill in real values. .env is gitignored and
# should never be committed.

# Google Books API key (Google Cloud Console -> APIs & Services -> Credentials).
# Required for reliable book discovery -- without it, Google Books falls back
# to a small shared anonymous quota that gets rate-limited quickly.
GOOGLE_BOOKS_API_KEY=

# Hardcover.app API token (hardcover.app -> account settings -> API).
# Optional but recommended -- Hardcover has much better coverage of
# indie/self-published LitRPG titles than Google Books/OpenLibrary, and its
# search results include an explicit series-position field, which is a more
# reliable source of a book's number than parsing it out of the title text.
# Marked "experimental" by Hardcover; if it starts failing consistently,
# discovery still works fine on Google Books + OpenLibrary alone.
HARDCOVER_API_KEY=

# Serper API key (https://serper.dev -> Dashboard -> API Key). Optional --
# powers a live web-search discovery provider that catches new releases/
# announcements the catalog APIs above haven't indexed yet (common for
# indie/self-published titles, right when they're announced or released).
# Replaces Brave Search, which is no longer viable as a provider (its only
# sub-enterprise tier caps out at 1000 queries/month). Serper's coverage of
# indie/LitRPG/web-serial sources is unverified and may differ from
# Brave's -- see discovery_agentic_migration_decision_log.md, and set only
# this key (leaving ANTHROPIC_API_KEY unset) to run discovery in
# diagnostic-only mode: raw search snippets are returned for inspection,
# with no LLM structuring and nothing added to the library. With both keys
# set, Serper finds candidate pages and Claude structures them into book
# data; if SERPER_API_KEY is missing, this provider is skipped and
# discovery still works fine on the catalog APIs alone.
SERPER_API_KEY=

# Anthropic API key (https://console.anthropic.com/ -> Settings -> API
# Keys). Used to turn raw web-search results (page titles/snippets) into
# structured book candidates (title, series number, release date, etc.) --
# see SERPER_API_KEY above.
ANTHROPIC_API_KEY=

# --- Access control (required once this is deployed publicly) ---------

# Your personal login password for full read/write access. Choose your own
# value -- there is no default, and the app will refuse logins until this
# is set.
OWNER_PASSWORD=

# Random signing key for owner login tokens. Generate a strong random value
# once (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`)
# and never change it casually -- changing it invalidates all existing
# logins.
AUTH_SECRET_KEY=

# A separate random token that grants read-only "viewer" access when
# present in the URL as ?share=<token> (no password needed). Anyone with
# this token/link can view the library but cannot add, edit, or delete
# anything -- that's enforced by the server, not just hidden in the UI.
# Generate the same way as AUTH_SECRET_KEY, with a different value.
SHARE_VIEW_TOKEN=

# Local-dev-only convenience: set to "true" to skip the OWNER_PASSWORD
# login entirely (every request is treated as the owner) when running the
# backend on your own machine. NEVER set this in a deployed environment's
# config (Render/Railway/etc.) -- doing so would remove login for anyone
# on the internet who finds the URL. tests/conftest.py forces this off for
# the duration of the test suite regardless of what's set here, so it's
# safe to leave "true" in your local .env permanently.
# Pair with NEXT_PUBLIC_AUTH_DISABLED=true in book-app-ui/.env.local to
# also skip the login screen in the frontend.
AUTH_DISABLED=

# --- Deployment ---------------------------------------------------------

# Where the SQLite file lives. Leave unset for local dev (defaults to
# ./books.db in the project folder). On Render/Railway, set this to a path
# inside your mounted persistent disk/volume, e.g. /data/books.db -- so the
# database survives restarts and redeploys instead of resetting each time.
DATABASE_PATH=
